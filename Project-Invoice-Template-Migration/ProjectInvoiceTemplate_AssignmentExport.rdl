          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ProjectCount">
          <DataField>ProjectCount</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="UnassignedProjectCount">
          <DataField>UnassignedProjectCount</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="StandardCount">
