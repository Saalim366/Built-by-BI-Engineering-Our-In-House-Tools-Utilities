<?xml version='1.0' encoding='utf-8'?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
  <Description>Read-only current-company invoice-template assignment export. Excel contains only the assignment table, including Status. CSV contains only ProjectID, StandardTemplateName, JointTemplateName and ManualTemplateName; unassigned roles are blank. Restore accepts this CSV file only. Source issues block CSV assignment-data export. No permanent table or procedure required.</Description>
  <Author>BQE CORE migration utility</Author>
  <AutoRefresh>0</AutoRefresh>
  <InitialPageName>Assignments</InitialPageName>
  <DataSources>
    <DataSource Name="BQE_GlobalDataSource">
      <rd:SecurityType>None</rd:SecurityType>
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>=Parameters!pConnectionString.Value</ConnectString>
      </ConnectionProperties>
      <rd:DataSourceID>9e6ba015-06c9-44ab-925e-dba128bb3df4</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="dsExportAssignments">
      <Query>
        <DataSourceName>BQE_GlobalDataSource</DataSourceName>
        <CommandText>/*
PROJECT INVOICE TEMPLATE ASSIGNMENT EXPORT | SQL Server 2022
Read-only against CORE. Run in the current company's PILOT database.
The RDL embeds this exact query. No permanent table/procedure is required.
Export the report directly to CSV for ProjectInvoiceTemplate_AssignmentRestore.sql.
Excel is a table-only review export, not a restore input. No SQL data block is generated.
NULL and the all-zero GUID both mean NOT ASSIGNED.
*/
SET NOCOUNT ON;
IF @@TRANCOUNT &lt;&gt; 0
BEGIN
    RAISERROR('Run the export outside an existing transaction.', 16, 1);
    RETURN;
END;
SET XACT_ABORT ON;
IF DB_NAME() IN (N'master', N'model', N'msdb', N'tempdb')
    THROW 51201, 'Connect the report to the current company database.', 1;
IF OBJECT_ID(N'dbo.Project', N'U') IS NULL
   OR OBJECT_ID(N'dbo.InvoiceTemplate', N'U') IS NULL
    THROW 51202, 'The connected database does not contain the required CORE tables.', 1;

DECLARE @Zero UNIQUEIDENTIFIER = '00000000-0000-0000-0000-000000000000';
DECLARE @BackupID UNIQUEIDENTIFIER = NEWID();
DECLARE @CapturedAtUtc DATETIME2(0);
DECLARE @DatabaseName NVARCHAR(128) = DB_NAME();

DROP TABLE IF EXISTS #PEProjects;
DROP TABLE IF EXISTS #PETemplates;
DROP TABLE IF EXISTS #PEProjectCounts;
DROP TABLE IF EXISTS #PETemplateIDCounts;
DROP TABLE IF EXISTS #PETemplateNameCounts;
DROP TABLE IF EXISTS #PECandidates;
DROP TABLE IF EXISTS #PESlots;
DROP TABLE IF EXISTS #PEIssues;
DROP TABLE IF EXISTS #PESnapshot;
DROP TABLE IF EXISTS #PEOutput;

-- Hold source reads only while taking the two-table snapshot.
BEGIN TRY
    BEGIN TRANSACTION;
    SELECT IDENTITY(INT, 1, 1) AS SourceRowNo, P.Project_ID,
           CONVERT(NVARCHAR(MAX), P.ProjectID) COLLATE DATABASE_DEFAULT AS ProjectID,
           NULLIF(P.StandardInvoiceTemplate_ID, @Zero) AS StandardInvoiceTemplate_ID,
           NULLIF(P.JointInvoiceTemplate_ID, @Zero) AS JointInvoiceTemplate_ID,
           NULLIF(P.ManualInvoiceTemplate_ID, @Zero) AS ManualInvoiceTemplate_ID
    INTO #PEProjects FROM dbo.Project AS P WITH (HOLDLOCK);

    SELECT T.InvoiceTemplate_ID,
           CONVERT(NVARCHAR(MAX), T.Name) COLLATE DATABASE_DEFAULT AS TemplateName
    INTO #PETemplates FROM dbo.InvoiceTemplate AS T WITH (HOLDLOCK)
    WHERE T.InvoiceTemplate_ID &lt;&gt; @Zero;
    SET @CapturedAtUtc = SYSUTCDATETIME();
    COMMIT TRANSACTION;
END TRY
BEGIN CATCH
    IF XACT_STATE() &lt;&gt; 0 ROLLBACK TRANSACTION;
    THROW;
END CATCH;

CREATE INDEX IX_PE_TemplateID ON #PETemplates (InvoiceTemplate_ID);
SELECT ProjectID, COUNT_BIG(*) AS MatchCount
INTO #PEProjectCounts FROM #PEProjects GROUP BY ProjectID;
SELECT InvoiceTemplate_ID, COUNT_BIG(*) AS MatchCount
INTO #PETemplateIDCounts FROM #PETemplates GROUP BY InvoiceTemplate_ID;
SELECT TemplateName, COUNT_BIG(*) AS MatchCount
INTO #PETemplateNameCounts FROM #PETemplates GROUP BY TemplateName;

SELECT P.*, C.MatchCount AS ProjectMatchCount
INTO #PECandidates FROM #PEProjects AS P
LEFT JOIN #PEProjectCounts AS C ON C.ProjectID = P.ProjectID
WHERE P.StandardInvoiceTemplate_ID IS NOT NULL
   OR P.JointInvoiceTemplate_ID IS NOT NULL
   OR P.ManualInvoiceTemplate_ID IS NOT NULL;

CREATE TABLE #PEIssues (
    SourceRowNo INT NOT NULL,
    ProjectID NVARCHAR(MAX) COLLATE DATABASE_DEFAULT NULL,
    TemplateRole NVARCHAR(10) NOT NULL,
    TemplateName NVARCHAR(MAX) COLLATE DATABASE_DEFAULT NULL,
    IssueMessage NVARCHAR(300) NOT NULL
);
INSERT #PEIssues (SourceRowNo, ProjectID, TemplateRole, IssueMessage)
SELECT SourceRowNo, ProjectID, N'Project',
       CASE WHEN NULLIF(LTRIM(RTRIM(ProjectID)), N'') IS NULL THEN N'Project ID is missing or blank.'
            WHEN DATALENGTH(ProjectID) &gt; 8000 THEN N'Project ID exceeds 4000 Unicode code units.'
            ELSE N'Project ID is duplicated. It cannot uniquely identify a project after migration.' END
FROM #PECandidates
WHERE NULLIF(LTRIM(RTRIM(ProjectID)), N'') IS NULL
   OR DATALENGTH(ProjectID) &gt; 8000 OR ProjectMatchCount &lt;&gt; 1;

SELECT P.SourceRowNo, P.ProjectID, V.TemplateRole, V.AssignedTemplate_ID, T.TemplateName,
       CONVERT(NVARCHAR(300), CASE
           WHEN V.AssignedTemplate_ID IS NULL THEN NULL
           WHEN ISNULL(IC.MatchCount, 0) = 0 THEN N'Assigned template ID does not exist in InvoiceTemplate.'
           WHEN IC.MatchCount &gt; 1 THEN N'Assigned template ID matches more than one record.'
           WHEN NULLIF(LTRIM(RTRIM(T.TemplateName)), N'') IS NULL THEN N'Assigned template name is missing or blank.'
           WHEN DATALENGTH(T.TemplateName) &gt; 8000 THEN N'Template name exceeds 4000 Unicode code units.'
           WHEN NC.MatchCount &gt; 1 THEN N'Template name is duplicated. It cannot uniquely identify a template after migration.'
           ELSE NULL END) AS IssueMessage
INTO #PESlots FROM #PECandidates AS P
CROSS APPLY (VALUES
    (N'Standard', P.StandardInvoiceTemplate_ID),
    (N'Joint', P.JointInvoiceTemplate_ID),
    (N'Manual', P.ManualInvoiceTemplate_ID)
) AS V(TemplateRole, AssignedTemplate_ID)
LEFT JOIN #PETemplateIDCounts AS IC ON IC.InvoiceTemplate_ID = V.AssignedTemplate_ID
OUTER APPLY (
    -- TOP (1) is only for displaying diagnostics; ambiguity always blocks export.
    SELECT TOP (1) T0.TemplateName FROM #PETemplates AS T0
    WHERE T0.InvoiceTemplate_ID = V.AssignedTemplate_ID ORDER BY T0.TemplateName
) AS T
LEFT JOIN #PETemplateNameCounts AS NC ON NC.TemplateName = T.TemplateName;
CREATE INDEX IX_PE_Slots ON #PESlots (SourceRowNo, TemplateRole);
INSERT #PEIssues
SELECT SourceRowNo, ProjectID, TemplateRole, TemplateName, IssueMessage
FROM #PESlots WHERE IssueMessage IS NOT NULL;
CREATE INDEX IX_PE_Issues ON #PEIssues (SourceRowNo);

SELECT CONVERT(INT, ROW_NUMBER() OVER (ORDER BY P.ProjectID, P.SourceRowNo)) AS RowNo,
       P.SourceRowNo, P.ProjectID,
       S.TemplateName AS StandardTemplateName, J.TemplateName AS JointTemplateName,
       M.TemplateName AS ManualTemplateName
INTO #PESnapshot FROM #PECandidates AS P
INNER JOIN #PESlots AS S ON S.SourceRowNo = P.SourceRowNo AND S.TemplateRole = N'Standard'
INNER JOIN #PESlots AS J ON J.SourceRowNo = P.SourceRowNo AND J.TemplateRole = N'Joint'
INNER JOIN #PESlots AS M ON M.SourceRowNo = P.SourceRowNo AND M.TemplateRole = N'Manual';

DECLARE @ProjectCount INT = (SELECT COUNT(*) FROM #PESnapshot);
DECLARE @IssueCount INT = (SELECT COUNT(*) FROM #PEIssues);
DECLARE @UnassignedProjectCount INT = (SELECT COUNT(*) FROM #PEProjects) - @ProjectCount;
DECLARE @StandardCount INT = (SELECT COUNT(*) FROM #PESlots WHERE TemplateRole = N'Standard' AND AssignedTemplate_ID IS NOT NULL);
DECLARE @JointCount INT = (SELECT COUNT(*) FROM #PESlots WHERE TemplateRole = N'Joint' AND AssignedTemplate_ID IS NOT NULL);
DECLARE @ManualCount INT = (SELECT COUNT(*) FROM #PESlots WHERE TemplateRole = N'Manual' AND AssignedTemplate_ID IS NOT NULL);
DECLARE @Status NVARCHAR(12) = CASE WHEN @IssueCount &gt; 0 THEN N'REVIEW' WHEN @ProjectCount = 0 THEN N'EMPTY' ELSE N'READY' END;
DECLARE @Message NVARCHAR(500) = CASE
    WHEN @IssueCount &gt; 0 THEN N'Backup not generated. Correct the issues listed below, then run the report again. No data has been changed.'
    WHEN @ProjectCount = 0 THEN N'No invoice-template assignments were found. Nothing needs to be backed up. No data has been changed.'
    ELSE N'Ready to export. Save the four-column CSV before migration and use that file with the restore script. Excel is for table-only review. No data has been changed.' END;

CREATE TABLE #PEOutput (
    RowKind NVARCHAR(10) NOT NULL, SortGroup INT NOT NULL, SortKey BIGINT NOT NULL,
    ProjectID NVARCHAR(MAX) NULL, StandardTemplateName NVARCHAR(MAX) NULL,
    JointTemplateName NVARCHAR(MAX) NULL, ManualTemplateName NVARCHAR(MAX) NULL,
    RowStatus NVARCHAR(30) NULL, TemplateRole NVARCHAR(10) NULL,
    IssueTemplateName NVARCHAR(MAX) NULL, RowMessage NVARCHAR(500) NULL
);
INSERT #PEOutput (RowKind, SortGroup, SortKey) VALUES (N'SUMMARY', 0, 0);
INSERT #PEOutput (RowKind, SortGroup, SortKey, ProjectID, StandardTemplateName,
                     JointTemplateName, ManualTemplateName, RowStatus)
SELECT N'DETAIL', 1, S.RowNo, S.ProjectID,
       CASE WHEN ST.AssignedTemplate_ID IS NOT NULL THEN ISNULL(NULLIF(S.StandardTemplateName, N''), N'[Missing template name]') ELSE NULL END,
       CASE WHEN JT.AssignedTemplate_ID IS NOT NULL THEN ISNULL(NULLIF(S.JointTemplateName, N''), N'[Missing template name]') ELSE NULL END,
       CASE WHEN MT.AssignedTemplate_ID IS NOT NULL THEN ISNULL(NULLIF(S.ManualTemplateName, N''), N'[Missing template name]') ELSE NULL END,
       CASE WHEN EXISTS (SELECT 1 FROM #PEIssues AS I WHERE I.SourceRowNo = S.SourceRowNo) THEN N'Needs review' ELSE N'Valid' END
FROM #PESnapshot AS S
INNER JOIN #PESlots AS ST ON ST.SourceRowNo = S.SourceRowNo AND ST.TemplateRole = N'Standard'
INNER JOIN #PESlots AS JT ON JT.SourceRowNo = S.SourceRowNo AND JT.TemplateRole = N'Joint'
INNER JOIN #PESlots AS MT ON MT.SourceRowNo = S.SourceRowNo AND MT.TemplateRole = N'Manual';
INSERT #PEOutput (RowKind, SortGroup, SortKey, ProjectID, TemplateRole, IssueTemplateName, RowMessage)
SELECT N'ISSUE', 2, ROW_NUMBER() OVER (ORDER BY SourceRowNo, TemplateRole), ProjectID, TemplateRole, TemplateName, IssueMessage
FROM #PEIssues;

SELECT @DatabaseName AS DatabaseName, @CapturedAtUtc AS CapturedAtUtc,
       CONVERT(NVARCHAR(36), @BackupID) AS BackupID, @Status AS ExportStatus, @Message AS ExportMessage,
       @ProjectCount AS ProjectCount, @UnassignedProjectCount AS UnassignedProjectCount,
       @StandardCount AS StandardCount, @JointCount AS JointCount, @ManualCount AS ManualCount,
       @IssueCount AS IssueCount,
       RowKind, SortKey, ProjectID, StandardTemplateName, JointTemplateName, ManualTemplateName,
       RowStatus, TemplateRole, IssueTemplateName, RowMessage
FROM #PEOutput ORDER BY SortGroup, SortKey;
</CommandText>
        <Timeout>180</Timeout>
      </Query>
      <Fields>
        <Field Name="DatabaseName">
          <DataField>DatabaseName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="CapturedAtUtc">
          <DataField>CapturedAtUtc</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
