        </Field>
        <Field Name="IssueCount">
          <DataField>IssueCount</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="RowKind">
          <DataField>RowKind</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="SortKey">
          <DataField>SortKey</DataField>
          <rd:TypeName>System.Int64</rd:TypeName>
        </Field>
        <Field Name="ProjectID">
          <DataField>ProjectID</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="StandardTemplateName">
          <DataField>StandardTemplateName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="JointTemplateName">
          <DataField>JointTemplateName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ManualTemplateName">
          <DataField>ManualTemplateName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="RowStatus">
          <DataField>RowStatus</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="TemplateRole">
          <DataField>TemplateRole</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="IssueTemplateName">
          <DataField>IssueTemplateName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="RowMessage">
          <DataField>RowMessage</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        </Fields>
    </DataSet>
